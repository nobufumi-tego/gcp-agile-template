# backend/.env.example
# .env として複製して値を入れる（.env は .gitignore 済み）

# GCP プロジェクト ID（Firestore / Secret Manager 等の宛先）
GOOGLE_CLOUD_PROJECT=your-project-id
PROJECT_ID=your-project-id

# アプリ名（FastAPI title などに使用）
APP_NAME=your-app

# ローカルで Firebase Admin SDK を使う場合のサービスアカウント鍵
# 本番（Cloud Run）では Application Default Credentials が自動的に使われるので不要
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
