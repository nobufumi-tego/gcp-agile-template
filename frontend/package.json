{
  "name": "app-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run modules:sync && vite dev",
    "build": "npm run modules:sync && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "modules:sync": "node ../scripts/sync-modules.mjs",
    "check": "npm run modules:sync && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "npm run modules:sync && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "mobile-check": "playwright test --project=mobile-chrome"
  },
  "dependencies": {
    "firebase": "^11.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/svelte": "^5.2.4",
    "jsdom": "^25.0.1",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
